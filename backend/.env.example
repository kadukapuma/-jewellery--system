PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jewellery_system

# Long random string - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Live market prices for the dashboard.
GOLD_PRICE_URL=https://www.goldpricetoday.lk/api/v1/gold-price

# Password for the first "admin" user created by `npm run db:seed`.
# The admin is forced to change it on first login.
ADMIN_PASSWORD=Admin@12345

# Task Manager Help Desk Integration (key from Task Manager > Customers > Help Desk Key).
# Leave empty to turn the help desk off. BRANCH_CODE is shown next to the user name on requests
# (defaults to the shop name from Settings).
TASK_MANAGER_API_URL=
TASK_MANAGER_API_KEY=
TASK_MANAGER_BRANCH_CODE=
